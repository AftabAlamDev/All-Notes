    {
      "parameters": {
        "jsCode": "// Extract text from uploaded documents\nconst items = $input.all();\nconst extractedDocs = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const binary = item.binary?.data;\n  \n  if (binary) {\n    extractedDocs.push({\n      json: {\n        documentId: `document_${i + 1}`,\n        fileName: binary.fileName || `file_${i + 1}`,\n        mimeType: binary.mimeType,\n        fileSize: binary.fileSize,\n        extractedText: \"Sample extracted text from document. This would contain the actual document content after OCR/parsing.\"\n      },\n      binary: {\n        data: binary\n      }\n    });\n  }\n}\n\nreturn extractedDocs;"
      },
      "id": "7c01a907-3fbc-4a6d-8d60-d61fc25d6559",
