        "jsCode": "// Generate comprehensive final report\nconst synthesis = $input.first().json.output;\n\nconst report = {\n  reportTitle: \"Multi-Agent Document Intelligence Report\",\n  generatedAt: new Date().toISOString(),\n  documentCount: 3,\n  \n  executiveSummary: synthesis.executive_summary,\n  \n  keyInsights: synthesis.key_insights,\n  \n  risks: synthesis.risks,\n  \n  opportunities: synthesis.opportunities,\n  \n  recommendations: synthesis.recommendations,\n  \n  conclusion: synthesis.conclusion,\n  \n  detailedAnalysis: {\n    finance: $('Finance Agent').first()?.json?.output || {},\n    legal: $('Legal Agent').first()?.json?.output || {},\n    research: $('Research Agent').first()?.json?.output || {},\n    hr: $('HR Agent').first()?.json?.output || {},\n    technical: $('Technical Agent').first()?.json?.output || {}\n  },\n  \n  metadata: {\n    workflowName: \"Multi-Agent Document Intelligence System\",\n    processingTime: \"Completed\",\n    agentsUsed: [\"Supervisor\", \"Finance\", \"Legal\", \"Research\", \"HR\", \"Technical\", \"Synthesis\"]\n  }\n};\n\nreturn [{ json: report }];"
      },
